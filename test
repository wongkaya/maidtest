<script>
(function(){
  let currentStep = 1;
  const totalSteps = 21; // 1 Meta + 8 Story + 12 Pola Pikir
  const APPS_SCRIPT_URL = 'GANTI_DENGAN_URL_WEB_APP_ANDA'; // <-- GANTI DI SINI

  const stepPanes = document.querySelectorAll('.step-pane');
  const btnNext = document.getElementById('btn-next');
  const btnPrev = document.getElementById('btn-prev');
  const navBar = document.getElementById('nav-bar');
  const errPane = document.getElementById('err-pane');
  const stepCounter = document.getElementById('step-counter');
  const progressPercent = document.getElementById('progress-percent');
  const progressFill = document.getElementById('progress-fill');

  // === AUTO-CALCULATE AGE FROM BIRTHDATE ===
  const birthdateInput = document.getElementById('worker_birthdate');
  const ageInput = document.getElementById('worker_age');

  function calculateAge(birthdateStr) {
    if(!birthdateStr) return '';
    const birth = new Date(birthdateStr);
    if(isNaN(birth.getTime())) return '';
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if(m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
      age--;
    }
    return age >= 0 ? age : '';
  }

  function updateAge() {
    const age = calculateAge(birthdateInput.value);
    ageInput.value = age !== '' ? age + ' tahun' : '';
  }

  birthdateInput.addEventListener('change', updateAge);
  birthdateInput.addEventListener('input', updateAge);

  // === OPTION CARD CLICK HANDLER ===
  document.querySelectorAll('.option-card').forEach(card => {
    card.addEventListener('click', function() {
      const radio = this.querySelector('input[type="radio"]');
      if(radio) {
        radio.checked = true;
        const grid = this.closest('.options-grid');
        if(grid) {
          grid.querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
        }
        this.classList.add('selected');
        errPane.style.display = 'none';
      }
    });
  });

  function updateProgress() {
    if(currentStep > totalSteps) {
      stepCounter.textContent = 'Selesai';
      progressPercent.textContent = '100%';
      progressFill.style.width = '100%';
      return;
    }
    stepCounter.textContent = `Langkah ${currentStep} dari ${totalSteps}`;
    const pct = Math.round(((currentStep - 1) / totalSteps) * 100);
    progressPercent.textContent = `${pct}%`;
    progressFill.style.width = `${pct}%`;
  }

  function validateStep(step) {
    if(step === 1) {
      const wName = document.getElementById('worker_name').value.trim();
      const bdate = document.getElementById('worker_birthdate').value.trim();
      const eName = document.getElementById('employer_name').value.trim();
      const age = document.getElementById('worker_age').value;
      if(!wName || !bdate || !eName) {
        errPane.textContent = 'Silakan lengkapi semua data identitas worker.';
        errPane.style.display = 'block';
        return false;
      }
      if(!age) {
        errPane.textContent = 'Usia tidak dapat dihitung dari tanggal lahir. Periksa kembali tanggalnya.';
        errPane.style.display = 'block';
        return false;
      }
    } else if(step >= 2 && step <= 9) {
      const pane = document.querySelector(`.step-pane[data-step="${step}"]`);
      const grids = pane.querySelectorAll('.options-grid');
      for(let g of grids) {
        const name = g.getAttribute('data-name');
        const checked = pane.querySelector(`input[name="${name}"]:checked`);
        if(!checked) {
          errPane.textContent = 'Harap jawab kedua pertanyaan emosi & reaksi.';
          errPane.style.display = 'block';
          return false;
        }
      }
    } else if(step >= 10 && step <= 21) {
      const pane = document.querySelector(`.step-pane[data-step="${step}"]`);
      const g = pane.querySelector('.options-grid');
      const name = g.getAttribute('data-name');
      const checked = pane.querySelector(`input[name="${name}"]:checked`);
      if(!checked) {
        errPane.textContent = 'Harap pilih salah satu opsi jawaban.';
        errPane.style.display = 'block';
        return false;
      }
    }
    errPane.style.display = 'none';
    return true;
  }

  function showStep(step) {
    stepPanes.forEach(pane => {
      pane.classList.remove('active');
      if(parseInt(pane.getAttribute('data-step')) === step) {
        pane.classList.add('active');
      }
    });

    btnPrev.style.display = step > 1 && step <= totalSteps ? 'inline-flex' : 'none';

    if(step > totalSteps) {
      navBar.style.display = 'none';
      calculateAndFillPreview();
    } else {
      navBar.style.display = 'flex';
      btnNext.textContent = (step === totalSteps) ? 'Selesai & Kirim' : 'Lanjutkan';
    }
    updateProgress();
    window.scrollTo({top: 0, behavior: 'smooth'});
  }

  btnNext.addEventListener('click', () => {
    if(validateStep(currentStep)) {
      currentStep++;
      showStep(currentStep);
    }
  });

  btnPrev.addEventListener('click', () => {
    if(currentStep > 1) {
      currentStep--;
      showStep(currentStep);
    }
  });

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  }

  function calculateResults() {
    const wName = document.getElementById('worker_name').value.trim();
    const eName = document.getElementById('employer_name').value.trim();
    const pos = document.getElementById('position').value;
    const age = document.getElementById('worker_age').value.replace(/\s*tahun$/i, '').trim();
    const bdate = document.getElementById('worker_birthdate').value;
    const lastJob = document.getElementById('last_job_type').value;
    const lastDur = document.getElementById('last_job_duration').value;
    const resign = document.getElementById('resign_reason').value;

    let healthyCount = 0;
    let mmBreakdown = {healthy:0, generalization:0, deletion:0, distortion:0};

    for(let i=1; i<=12; i++) {
      const val = document.querySelector(`input[name="mm_${i}"]:checked`)?.value;
      if(val) {
        mmBreakdown[val] = (mmBreakdown[val] || 0) + 1;
        if(val === 'healthy') healthyCount++;
      }
    }

    const healthyScorePct = Math.round((healthyCount / 12) * 100);

    let emotions = [];
    let responses = [];
    for(let i=1; i<=8; i++) {
      const e = document.querySelector(`input[name="emo_${i}"]:checked`)?.value;
      const r = document.querySelector(`input[name="resp_${i}"]:checked`)?.value;
      if(e) emotions.push(e);
      if(r) responses.push(r);
    }

    let archetype = "The Careful Worker";
    let subTitle = "Teliti, Patuh, namun Cenderung Cemas & Takut Salah";
    if(healthyScorePct >= 75) {
      archetype = "The Steady Anchor";
      subTitle = "Stabil, Asertif, Berani Bertanggung Jawab & Dewasa";
    } else if(mmBreakdown.distortion >= 4) {
      archetype = "The Quiet Endurer";
      subTitle = "Sering Berasumsi, Memendam Rasa Kecewa";
    } else if(mmBreakdown.generalization >= 4) {
      archetype = "The Pessimistic Sentinel";
      subTitle = "Cenderung Menyamaratakan Keadaan Negatif";
    }

    const uniqEmo = [...new Set(emotions)];
    const uniqResp = [...new Set(responses)];

    const callout = `Kandidat ${wName} memiliki skor Pola Pikir Sehat sebesar ${healthyScorePct}% (${healthyCount}/12). ` +
      `Dominasi emosi saat tertekan adalah ${uniqEmo.slice(0,3).join(', ')} dengan kecenderungan respons ${uniqResp.slice(0,2).join(', ')}.`;

    const commGuide = `Rekomendasi Komunikasi Majikan:
- Gunakan intonasi netral dan beri instruksi/SOP yang spesifik.
- Hindari menegur di depan orang lain untuk mencegah munculnya respons panik atau pasrah.
- Berikan pujian spesifik saat tugas selesai dengan baik untuk membangun kepercayaan dirinya.`;

    // === RAW ANSWERS (untuk kolom detail di Spreadsheet) ===
    const rawAnswers = {};
    for (let i = 1; i <= 8; i++) {
      rawAnswers['emo_' + i] = document.querySelector(`input[name="emo_${i}"]:checked`)?.value || '';
      rawAnswers['resp_' + i] = document.querySelector(`input[name="resp_${i}"]:checked`)?.value || '';
    }
    for (let i = 1; i <= 12; i++) {
      rawAnswers['mm_' + i] = document.querySelector(`input[name="mm_${i}"]:checked`)?.value || '';
    }

    return {
      worker_name: wName,
      employer_name: eName,
      position: pos,
      worker_age: age,
      worker_birthdate: bdate,
      last_job_type: lastJob,
      last_job_duration: lastDur,
      resign_reason: resign,
      archetype: archetype,
      subtitle: subTitle,
      healthy_score: healthyScorePct,
      healthy_count: healthyCount,
      total_mm: 12,
      mm_breakdown: mmBreakdown,
      emotions: uniqEmo,
      responses: uniqResp,
      callout: callout,
      comm_guide: commGuide,
      ...rawAnswers   // <-- Patch: kirim jawaban mentah per pertanyaan
    };
  }

  function calculateAndFillPreview() {
    const results = calculateResults();
    window.__assessmentResults = results;

    document.getElementById('submit-preview').innerHTML = `
      <div style="display:grid;gap:6px;">
        <div><b>Nama:</b> ${escapeHtml(results.worker_name)}</div>
        <div><b>Tanggal Lahir:</b> ${escapeHtml(results.worker_birthdate)}</div>
        <div><b>Usia:</b> ${escapeHtml(results.worker_age)} tahun</div>
        <div><b>Pemberi Kerja:</b> ${escapeHtml(results.employer_name)}</div>
        <div><b>Posisi Dilamar:</b> ${escapeHtml(results.position)}</div>
        <div><b>Pekerjaan Terakhir:</b> ${escapeHtml(results.last_job_type)}</div>
        <div><b>Lama Bekerja:</b> ${escapeHtml(results.last_job_duration)}</div>
        <div><b>Alasan Resign:</b> ${escapeHtml(results.resign_reason)}</div>
      </div>
    `;
  }

  // === SUBMIT TO GOOGLE APPS SCRIPT ===
  document.getElementById('btn-submit').onclick = function() {
    const btn = this;
    const statusEl = document.getElementById('submit-status');
    const results = window.__assessmentResults;

    if(!results) {
      statusEl.textContent = 'Data tidak ditemukan. Silakan muat ulang halaman.';
      statusEl.style.color = '#B3261E';
      return;
    }

    if(APPS_SCRIPT_URL.indexOf('GANTI_DENGAN') !== -1) {
      statusEl.textContent = '⚠️ URL Apps Script belum dikonfigurasi. Hubungi admin.';
      statusEl.style.color = '#B3261E';
      return;
    }

    btn.disabled = true;
    statusEl.textContent = 'Mengirim laporan...';
    statusEl.style.color = 'var(--ink2)';

    fetch(APPS_SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(results)
    })
    .then(() => {
      setTimeout(() => {
        document.getElementById('submit-preview').innerHTML = `
          <div style="text-align:center;padding:24px 16px;">
            <div style="font-size:52px;margin-bottom:8px;">✅</div>
            <h3 style="color:var(--acc);margin-bottom:8px;font-size:17px;">Laporan Terkirim</h3>
            <p style="color:var(--ink2);font-size:13px;line-height:1.6;">
              Laporan assessment <b>${escapeHtml(results.worker_name)}</b> telah dikirim ke admin.
              Admin akan menerima ringkasan via email dan data lengkap di Google Spreadsheet.
            </p>
            <p style="color:var(--ink3);font-size:11.5px;margin-top:12px;">Terima kasih telah menyelesaikan assessment ini.</p>
          </div>
        `;
        btn.style.display = 'none';
        statusEl.textContent = '';
      }, 1200);
    })
    .catch(err => {
      btn.disabled = false;
      statusEl.textContent = '❌ Gagal mengirim. Periksa koneksi internet lalu coba lagi.';
      statusEl.style.color = '#B3261E';
      console.error(err);
    });
  };

})();
</script>
